{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archivi-in-gioco",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archivi-in-gioco-db",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE_FILES",
      "bucket_name": "archivi-in-gioco-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
